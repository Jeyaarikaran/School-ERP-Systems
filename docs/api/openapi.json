{
  "openapi": "3.1.0",
  "info": {
    "title": "EduCore ERP API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness check",
        "responses": {
          "200": { "description": "Ready" },
          "503": { "description": "Service Unavailable" }
        }
      }
    },
    "/api/v1/ping": {
      "get": {
        "summary": "Ping",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object" },
          "message": { "type": "string" },
          "meta": {
            "type": "object",
            "properties": {
              "request_id": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
